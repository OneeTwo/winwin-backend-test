# Copy to .env and replace the placeholders before starting.
# For an existing postgres_data volume, keep its current user and password.
POSTGRES_URL=jdbc:postgresql://postgres:5432/winwin_db
POSTGRES_USER=winwin
POSTGRES_PASSWORD=replace-with-a-strong-database-password
# Generate each secret separately, for example: openssl rand -hex 32
# JWT_SECRET must contain at least 32 bytes.
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
INTERNAL_TOKEN=replace-with-a-separate-random-internal-token
DATA_API_URL=http://data-api:8081
